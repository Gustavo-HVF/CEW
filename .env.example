# Copie para .env e preencha. O arquivo .env nunca vai para o git.

# Obrigatoria: chave da API do Google Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Opcional (modo Deep): pasta onde o Ghidra foi extraido, a que contem support/analyzeHeadless.
# Ex.: /opt/ghidra_12.1.4_PUBLIC  ou  C:\ferramentas\ghidra_12.1.4_PUBLIC
GHIDRA_INSTALL_DIR=

# Opcional: caminho do craft-anything-cli se ele nao estiver no PATH nem em ferramentas/.
# CEW_CRAFT_ANYTHING_CLI=
