{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cew.local/schemas/gemini/resposta_comparacao_visual.schema.json",
  "title": "Resposta Gemini: comparacao visual",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "gerado_por": { "type": "string", "enum": ["cew-gemini-worker"] },
    "parecido": { "type": "boolean" },
    "nota_similaridade": { "type": "number", "minimum": 0, "maximum": 1 },
    "diferencas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regiao": { "type": "string" },
          "descricao": { "type": "string" },
          "gravidade": { "type": "string", "enum": ["baixa", "media", "alta"] }
        },
        "required": ["regiao", "descricao", "gravidade"]
      }
    },
    "sugestoes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "gerado_por", "parecido", "nota_similaridade", "diferencas", "sugestoes"]
}
