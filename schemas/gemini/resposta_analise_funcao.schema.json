{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cew.local/schemas/gemini/resposta_analise_funcao.schema.json",
  "title": "Resposta Gemini: papel de uma funcao",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "gerado_por": { "type": "string", "enum": ["cew-gemini-worker"] },
    "resumo": { "type": "string" },
    "papel": { "type": "string", "enum": ["carregador_formato", "descompactacao", "fisica", "controles", "maquina_estados", "renderizacao", "audio", "rede", "interface", "outro"] },
    "formatos_relacionados": { "type": "array", "items": { "type": "string" } },
    "estruturas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "campos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "nome": { "type": "string" }, "offset": { "type": "integer", "minimum": 0 }, "tipo": { "type": "string" } },
              "required": ["nome", "offset", "tipo"]
            }
          }
        },
        "required": ["nome", "campos"]
      }
    },
    "confianca": { "type": "number", "minimum": 0, "maximum": 1 },
    "duvidas": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "gerado_por", "resumo", "papel", "formatos_relacionados", "estruturas", "confianca", "duvidas"]
}
